# GitHub personal access token (repo scope)
GITHUB_TOKEN=

# Optional: GitHub username for PR inbox searches (defaults to the token user)
# GITHUB_LOGIN=

# Jira Cloud (optional). Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=
# On macOS, if JIRA_API_TOKEN is unset, the server reads the keychain item:
#   security find-generic-password -a "$USER" -s jira-api-token -w


# Path to Claude Code CLI (default: claude)
CLAUDE_BIN=claude

# Data directory for cloned repos and worktrees
DATA_DIR=./data

# Server port
PORT=3001

# Bind address. Defaults to loopback. Set 0.0.0.0 only if you intend to expose
# the UI on the network, and pair it with AUTH_TOKEN.
# HOST=127.0.0.1

# Optional shared secret. When set, API requests need Authorization: Bearer <token>
# (or an access_token query param on the SSE stream).
# AUTH_TOKEN=
